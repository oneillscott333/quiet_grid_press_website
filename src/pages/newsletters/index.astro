---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Newsletters | Quiet Grid Press"
  description="The Quiet Grid Press newsletters are under construction."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">Newsletters</p>
      <h1>Under Construction</h1>
      <p class="lede">
        Our newsletters are being prepared. They will bring new-book news
        and puzzle notes from Quiet Grid Press. Please check back soon.
      </p>
      <div class="button-row centered-buttons">
        <a class="button" href="/books/">Explore the Books</a>
        <a class="button button-secondary" href="/">Return Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
