---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | Quiet Grid Press"
  description="Learn why Quiet Grid Press creates calm, thoughtful puzzle books for adults 50+."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">About Quiet Grid Press</p>
      <h1>Made with Care for the Person Holding the Pencil</h1>
      <p class="lede">
        Quiet Grid Press creates recreational puzzle books for adults 50+.
        Every book is shaped by a simple idea: the challenge should be
        satisfying, and the experience of using the book should feel calm,
        clear, and considered.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell prose-grid">
      <div>
        <p class="eyebrow">Why We Are Here</p>
        <h2>A Welcome Place for Focus and Enjoyment</h2>
      </div>
      <div class="prose">
        <p>
          We believe quiet mental engagement can be a meaningful and enjoyable
          part of everyday life. A good puzzle offers structure, discovery, and
          the particular satisfaction of finding the next right answer.
        </p>
        <p>
          Our work is centered on love understood as willing the best for
          another. That means respecting readers, telling the truth about every
          book, and putting care into details that are easy to overlook but
          important to the person using the page.
        </p>
      </div>
    </div>
  </section>

  <section class="values-band">
    <div class="shell values-grid about-values">
      <div>
        <p class="eyebrow eyebrow-light">What Readers Can Expect</p>
        <h2>Premium Means the Care Is Visible</h2>
      </div>
      <div class="value">
        <h3>Honest Challenge</h3>
        <p>Difficulty should match its label and feel earned.</p>
      </div>
      <div class="value">
        <h3>Thoughtful Design</h3>
        <p>Clear hierarchy, generous space, and no unnecessary clutter.</p>
      </div>
      <div class="value">
        <h3>Respect</h3>
        <p>Warm, intelligent communication without hype or condescension.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell founder-note">
      <div class="founder-initial" aria-hidden="true">SO</div>
      <div>
        <p class="eyebrow">From the Founder</p>
        <h2>Building One Good Book at a Time</h2>
        <p>
          Quiet Grid Press is a growing independent imprint founded by Scott
          O'Neill. USA250 Sudoku is the first book in a catalog being built
          around calm recreation, careful craftsmanship, and lasting value.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
