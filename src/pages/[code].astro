---
// A single-book short link (quietgridpress.com/bvfb03 and the like), built from src/data/forward_links.json,
// which build_redirects.py writes from 02_brand/qgp_short_links.json. Never edit that data file by hand.
import ForwardPage from "../components/ForwardPage.astro";
import links from "../data/forward_links.json";

export function getStaticPaths() {
  return links.map((link) => ({ params: { code: link.code }, props: { link } }));
}

const { link } = Astro.props;
const heading = link.stand_in
  ? `${link.book_title} is not on sale yet.`
  : `Opening ${link.opens_title} on Amazon.`;
const line = link.stand_in
  ? `Opening Book 1 of the series, ${link.opens_title}, on Amazon.`
  : "Quiet Grid Press books are sold on Amazon.";
const description = link.stand_in
  ? `${link.book_title} is not on sale yet. This link opens Book 1 of the series on Amazon.`
  : `This link opens ${link.opens_title} on Amazon.`;
---

<ForwardPage title={link.opens_title} heading={heading} line={line} url={link.amazon_url} delayMs={500} description={description} />
