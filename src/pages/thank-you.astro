---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank You | Quiet Grid Press"
  description="Thank you for signing up for Quiet Grid Press email updates."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">You Are on the List</p>
      <h1>Thank You for Signing Up</h1>
      <p class="lede">
        We will send occasional news about new books, puzzles, and thoughtful
        offers from Quiet Grid Press.
      </p>
      <div class="button-row centered-buttons">
        <a class="button" href="/books/">Explore the Books</a>
        <a class="button button-secondary" href="/">Return Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
