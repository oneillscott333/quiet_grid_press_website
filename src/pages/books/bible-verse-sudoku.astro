---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Bible Verse Sudoku | Quiet Grid Press"
  description="120 easy Sudoku puzzles paired with Scripture from the King James Version."
>
  <section class="book-detail-hero paper-texture">
    <div class="shell book-detail-grid">
      <div class="detail-cover cover-shadow">
        <img
          src="/images/bible120-cover.webp"
          srcset="
            /images/bible120-cover-450.webp 450w,
            /images/bible120-cover.webp 900w
          "
          sizes="(max-width: 680px) 78vw, 430px"
          alt="Bible Verse Sudoku: King James Version Edition book cover"
          width="900"
          height="1167"
        />
      </div>
      <div class="detail-copy">
        <p class="eyebrow">Quiet Grid Press · Now Available</p>
        <h1>Bible Verse Sudoku</h1>
        <p class="subtitle">King James Version Edition</p>
        <p class="lede">
          Settle into 120 easy Sudoku puzzles, each paired with a carefully
          selected verse from the King James Version.
        </p>
        <div class="detail-facts" aria-label="Book details">
          <span><strong>120</strong> easy puzzles</span>
          <span><strong>8.5 × 11</strong> inches</span>
          <span><strong>One</strong> puzzle per page</span>
          <span><strong>KJV</strong> verses with references</span>
        </div>
        <a
          class="button"
          href="https://www.amazon.com/dp/B0HDL8V5ZZ"
          target="_blank"
          rel="noopener noreferrer"
          data-track="amazon-outbound"
        >
          View on Amazon
        </a>
        <p class="retailer-note">Current price and availability are shown on Amazon.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell prose-grid">
      <div>
        <p class="eyebrow">Inside the Book</p>
        <h2>A Gentle Path Through Scripture and Logic</h2>
      </div>
      <div class="prose">
        <p>
          <em>Bible Verse Sudoku</em> brings together 120 easy 9 × 9 Sudoku
          puzzles and thoughtfully selected King James Version verses. Each
          spacious page gives one puzzle and one verse room to be enjoyed
          without hurry.
        </p>
        <p>
          Twelve calm themes create a gentle journey through light and trust,
          wisdom, peace, hope, service, fellowship, and a steady journey home.
          Complete solutions are included for every puzzle.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell">
      <div class="section-heading centered">
        <p class="eyebrow">What You Will Find</p>
        <h2>Clear Puzzles, Meaningful Moments</h2>
      </div>
      <div class="spec-grid">
        <article>
          <span>120</span>
          <h3>Easy Sudoku Puzzles</h3>
          <p>An inviting, unhurried challenge for each day.</p>
        </article>
        <article>
          <span>12</span>
          <h3>Thoughtful Themes</h3>
          <p>A gentle path through Scripture and reflection.</p>
        </article>
        <article>
          <span>KJV</span>
          <h3>Verses with References</h3>
          <p>Carefully selected Scripture alongside every puzzle.</p>
        </article>
        <article>
          <span>100%</span>
          <h3>Complete Solutions</h3>
          <p>Every puzzle is supported by the answer section.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell closing-card">
      <div>
        <p class="eyebrow">A Thoughtful Gift or Daily Pause</p>
        <h2>Make Room for Scripture and a Satisfying Puzzle</h2>
        <p>
          A peaceful, screen-free companion for quiet mornings, thoughtful
          breaks, or a meaningful gift.
        </p>
      </div>
      <a
        class="button"
        href="https://www.amazon.com/dp/B0HDL8V5ZZ"
        target="_blank"
        rel="noopener noreferrer"
        data-track="amazon-outbound"
      >
        View on Amazon
      </a>
    </div>
  </section>
</BaseLayout>
