---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
import series from "../../data/bible_series.json";
---

<BaseLayout
  title="Books | Quiet Grid Press"
  description="Explore thoughtfully designed Quiet Grid Press puzzle books."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">The Quiet Grid Press Collection</p>
      <h1>Books Worth Returning To</h1>
      <p class="lede">
        Each book begins with a clear purpose: a comfortable solving
        experience, honest challenge, and a theme that adds enjoyment without
        adding noise.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell catalog-grid">
      {
        series.map((b) => (
          <BookCard
            href={b.path}
            cover={`/images/${b.cover}.webp`}
            coverSmall={`/images/${b.cover}-450.webp`}
            coverWidth={900}
            coverHeight={1165}
            title={b.number === 1 ? "Bible Verse Sudoku" : b.title}
            alt={`Bible Verse Sudoku, Book ${b.number}: ${b.short}, King James Version book cover`}
            kicker={`Book ${b.number} of the Bible Verse Sudoku Series · 120 easy puzzles · King James Version`}
            eyebrow={b.status === "live" ? "Now Available" : "Coming soon"}
          />
        ))
      }
      <BookCard />
    </div>
  </section>
</BaseLayout>
