---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BookCard from "../../components/BookCard.astro";
---

<BaseLayout
  title="Books | Quiet Grid Press"
  description="Explore thoughtfully designed Quiet Grid Press puzzle books."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">The Quiet Grid Press Collection</p>
      <h1>Books Worth Returning To</h1>
      <p class="lede">
        Each book begins with a clear purpose: a comfortable solving
        experience, honest challenge, and a theme that adds enjoyment without
        adding noise.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell catalog-grid">
      <BookCard
        href="/books/bible-verse-sudoku/"
        cover="/images/bible120-cover.webp"
        coverSmall="/images/bible120-cover-450.webp"
        coverWidth={900}
        coverHeight={1165}
        title="Bible Verse Sudoku"
        alt="Bible Verse Sudoku, Book 1: Scripture, King James Version book cover"
        kicker="Book 1 of the Bible Verse Sudoku Series · 120 easy puzzles · King James Version"
      />
      <BookCard />
    </div>
  </section>
</BaseLayout>
