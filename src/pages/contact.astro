---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | Quiet Grid Press"
  description="Email, social media and postal contact information for Quiet Grid Press."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">Contact Quiet Grid Press</p>
      <h1>We Welcome Thoughtful Correspondence</h1>
      <p class="lede">
        Write to us by email or mail, or find Quiet Grid Press on Pinterest,
        Facebook and YouTube.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell contact-card">
      <div class="mail-mark" aria-hidden="true">
        <svg viewBox="6294 2950 22167 22167" role="img">
          <use href="/images/qgp-logo-artboard.svg#qgp-monogram"></use>
        </svg>
      </div>
      <div>
        <p class="eyebrow">Postal Address</p>
        <address>
          Quiet Grid Press<br />
          6040 E. Main St. #191<br />
          Mesa, AZ 85205
        </address>
        <p class="contact-note">
          Please do not send payment information, account credentials, or
          original irreplaceable materials by mail.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell keep-in-touch">
      <div class="section-heading centered">
        <p class="eyebrow">Keep in Touch</p>
        <h2>Email and Social Media</h2>
      </div>
      <div class="touch-grid">
        <div>
          <h3>Email</h3>
          <p>
            <a href="mailto:hello@quietgridpress.com">hello@quietgridpress.com</a><br />
            <span>Questions and general correspondence</span>
          </p>
          <p>
            <a href="mailto:feedback@quietgridpress.com">feedback@quietgridpress.com</a><br />
            <span>Comments about our books</span>
          </p>
        </div>
        <div>
          <h3>Follow Along</h3>
          <p>
            <a href="https://www.pinterest.com/quietgridpress/" target="_blank" rel="noopener noreferrer">Pinterest</a><br />
            <span>pinterest.com/quietgridpress</span>
          </p>
          <p>
            <a href="https://www.facebook.com/quietgridpress" target="_blank" rel="noopener noreferrer">Facebook</a><br />
            <span>facebook.com/quietgridpress</span>
          </p>
          <p>
            <a href="https://www.youtube.com/@quietgridpress" target="_blank" rel="noopener noreferrer">YouTube</a><br />
            <span>youtube.com/@quietgridpress</span>
          </p>
        </div>
        <div>
          <h3>Newsletter</h3>
          <p>
            <a href="/newsletters/">Newsletters</a><br />
            <span>Under construction</span>
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="shell faq">
      <div class="section-heading centered">
        <p class="eyebrow">Helpful Answers</p>
        <h2>Common Questions</h2>
        <p>
          These answers cover the questions we can resolve clearly today. New
          or unusual questions will be reviewed personally.
        </p>
      </div>
      <div class="faq-list">
        <details>
          <summary>Where can I buy Quiet Grid Press books?</summary>
          <p>
            Quiet Grid Press books are available from Amazon.
            <a
              class="text-link"
              href="https://www.amazon.com/dp/B0HDL8V5ZZ"
              target="_blank"
              rel="noopener noreferrer"
              data-track="amazon-outbound"
            >
              View Bible Verse Sudoku on Amazon <span aria-hidden="true">→</span>
            </a>
            <br />
            <a
              class="text-link"
              href="https://www.amazon.com/dp/B0H7QJJYWZ"
              target="_blank"
              rel="noopener noreferrer"
              data-track="amazon-outbound"
            >
              View USA250 Sudoku on Amazon <span aria-hidden="true">→</span>
            </a>
          </p>
        </details>
        <details>
          <summary>Are answers included?</summary>
          <p>
            Yes. USA250 Sudoku includes a complete answer section for all 250
            puzzles.
          </p>
        </details>
        <details>
          <summary>What difficulty levels are included in USA250 Sudoku?</summary>
          <p>
            The book progresses through Easy, Medium, and Hard Sudoku puzzles.
          </p>
        </details>
        <details>
          <summary>Is this a large-print book?</summary>
          <p>
            No. The book uses a comfortable 8.5 × 11-inch format, but it is not
            represented or classified as a large-print edition.
          </p>
        </details>
        <details>
          <summary>Who handles orders, delivery, returns, or damaged copies?</summary>
          <p>
            Amazon handles purchasing, delivery, returns, and order support for
            books purchased through its store. Please use the support options
            connected to your Amazon order.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
