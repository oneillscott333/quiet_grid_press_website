---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Quiet Grid Press"
  description="The requested Quiet Grid Press page could not be found."
>
  <section class="page-intro paper-texture">
    <div class="shell narrow">
      <p class="eyebrow">Page Not Found</p>
      <h1>That Page Is Not Here</h1>
      <p class="lede">
        The address may have changed, or the page may no longer be available.
        You can return home or continue exploring our books.
      </p>
      <div class="button-row centered-buttons">
        <a class="button" href="/">Return Home</a>
        <a class="button button-secondary" href="/books/">Explore Books</a>
      </div>
    </div>
  </section>
</BaseLayout>
