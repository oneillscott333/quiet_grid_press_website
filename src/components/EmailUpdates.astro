<section class="updates-panel" aria-labelledby="updates-title">
  <div>
    <p class="eyebrow">From Quiet Grid Press</p>
    <h2 id="updates-title">Stay in the Loop, Gently</h2>
    <p>
      Receive occasional new-book announcements, puzzle news, and thoughtful
      offers from Quiet Grid Press. No crowded inbox.
    </p>
  </div>
  <form
    class="email-signup"
    name="email-updates"
    method="POST"
    action="/thank-you/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="email-updates" />
    <p class="visually-hidden">
      <label>
        Leave this field empty if you are human
        <input name="bot-field" />
      </label>
    </p>
    <label for="email-updates-address">Email address</label>
    <div class="email-signup-row">
      <input
        id="email-updates-address"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder="you@example.com"
        required
      />
      <button class="button" type="submit">Keep Me Posted</button>
    </div>
    <p class="email-signup-note">
      By signing up, you agree to receive Quiet Grid Press email updates. See
      our <a href="/privacy/">Privacy Policy</a>.
    </p>
  </form>
</section>
