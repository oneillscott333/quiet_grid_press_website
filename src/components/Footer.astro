---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="Quiet Grid Press home">
        <span class="brand-logo brand-logo-small" aria-hidden="true">
          <svg viewBox="6294 2950 22167 22167" role="img">
            <use href="/images/qgp-logo-artboard.svg#qgp-monogram"></use>
          </svg>
        </span>
        <span class="brand-name">Quiet Grid Press</span>
      </a>
      <p>Thoughtfully designed puzzle books for adults 50+.</p>
    </div>
    <div class="footer-links">
      <p class="footer-heading">Information</p>
      <a href="/terms/">Terms of Use</a>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/accessibility/">Accessibility</a>
    </div>
    <div class="footer-links">
      <p class="footer-heading">Explore</p>
      <a href="/books/">Books</a>
      <a href="/blog/">Blog</a>
      <a href="/newsletters/">Newsletters</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
  <div class="shell copyright">
    <p>© {year} Quiet Grid Press. All rights reserved.</p>
  </div>
</footer>
