<section class="signup-panel" aria-labelledby="signup-title">
  <div>
    <p class="eyebrow">From Quiet Grid Press</p>
    <h2 id="signup-title">A Thoughtful Note, Now and Then</h2>
    <p>
      New-book announcements, puzzle news, and occasional offers. No noise,
      no crowded inbox.
    </p>
  </div>
  <form class="signup-form" aria-describedby="signup-status">
    <label>
      <span>First name</span>
      <input
        type="text"
        name="first_name"
        autocomplete="given-name"
        placeholder="Friend"
        disabled
      />
    </label>
    <label>
      <span>Email address</span>
      <input type="email" name="email" autocomplete="email" disabled />
    </label>
    <p class="consent">
      By subscribing, you agree to receive Quiet Grid Press news, puzzle
      content, surveys, community updates, and occasional promotions. We will
      never sell or rent your information. Every email will include an easy
      way to unsubscribe.
    </p>
    <button type="button" class="button button-muted" disabled>Subscribe</button>
    <p id="signup-status" class="preview-note">
      Local preview: signup is not connected, and no information is collected.
    </p>
  </form>
</section>
